{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "啟動網站（Edge）",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
            "runtimeArgs": [
                "--user-data-dir=${userHome}/.vscode-edge-debug-profile",
                "--no-first-run",
                "--no-default-browser-check"
            ],
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "啟動網站（Chrome）",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
            "runtimeArgs": [
                "--user-data-dir=${userHome}/.vscode-chrome-debug-profile",
                "--no-first-run",
                "--no-default-browser-check"
            ],
            "webRoot": "${workspaceFolder}"
        }
    ]
}
